generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Location {
  id                    String                @id @default(cuid())
  slug                  String                @unique
  name                  String
  nameBn                String?
  country               String
  region                String?
  city                  String?
  district              String?
  latitude              Float?
  longitude             Float?
  type                  String                @default("city")
  parentId              String?
  description           String?
  isDemo                Boolean               @default(false)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  dataGaps              DataGap[]
  evidenceRecords       EvidenceRecord[]
  intelligenceSummaries IntelligenceSummary[]
  parent                Location?             @relation("LocationHierarchy", fields: [parentId], references: [id])
  children              Location[]            @relation("LocationHierarchy")
  researchItems         ResearchItem[]
  timelineEvents        TimelineEvent[]

  @@index([slug])
  @@index([country])
  @@index([type])
  @@index([isDemo])
}

model EnvironmentalCategory {
  id              String           @id @default(cuid())
  slug            String           @unique
  name            String
  nameBn          String?
  icon            String?
  color           String?
  order           Int              @default(0)
  createdAt       DateTime         @default(now())
  evidenceRecords EvidenceRecord[]
  parameters      Parameter[]
}

model Parameter {
  id              String                @id @default(cuid())
  slug            String                @unique
  name            String
  nameBn          String?
  unit            String?
  categoryId      String
  description     String?
  createdAt       DateTime              @default(now())
  evidenceRecords EvidenceRecord[]
  category        EnvironmentalCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

model Source {
  id                  String           @id @default(cuid())
  name                String
  provider            String?
  url                 String?
  apiEndpoint         String?
  license             String?
  commercialUse       String?          @default("REQUIRES REVIEW")
  attributionReq      String?
  updateFrequency     String?
  dataCategories      String?
  geographicCoverage  String?
  temporalCoverage    String?
  reliabilityNotes    String?
  ingestionMethod     String?
  status              String           @default("active")
  lastSuccessfulFetch DateTime?
  nextScheduledUpdate DateTime?
  lastFailureReason   String?
  errorCount          Int              @default(0)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  evidenceRecords     EvidenceRecord[]
  researchItems       ResearchItem[]
  updateLogs          UpdateLog[]

  @@index([status])
}

model EvidenceRecord {
  id                      String                 @id @default(cuid())
  value                   String?
  numericValue            Float?
  unit                    String?
  parameterId             String?
  categoryId              String?
  locationId              String?
  samplingSite            String?
  latitude                Float?
  longitude               Float?
  geographicPrecision     String?
  observationDate         DateTime?
  sourcePublicationDate   DateTime?
  collectionDate          DateTime?
  retrievalDate           DateTime               @default(now())
  sourceId                String?
  sourceTitle             String?
  sourceUrl               String?
  doi                     String?
  originalDatasetUrl      String?
  publisher               String?
  originalLanguage        String?                @default("en")
  methodology             String?
  measurementMethod       String?
  license                 String?
  commercialUseStatus     String?                @default("REQUIRES REVIEW")
  attributionRequirements String?
  processingHistory       String?
  confidence              String                 @default("UNVERIFIED")
  evidenceType            String?
  verificationStatus      String                 @default("pending")
  claim                   String?
  qualityStatus           String                 @default("valid")
  qualityNotes            String?
  isDemo                  Boolean                @default(false)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  category                EnvironmentalCategory? @relation(fields: [categoryId], references: [id])
  location                Location?              @relation(fields: [locationId], references: [id])
  parameter               Parameter?             @relation(fields: [parameterId], references: [id])
  source                  Source?                @relation(fields: [sourceId], references: [id])

  @@index([locationId])
  @@index([categoryId])
  @@index([sourceId])
  @@index([confidence])
  @@index([verificationStatus])
  @@index([isDemo])
  @@index([evidenceType])
}

model ResearchItem {
  id                  String    @id @default(cuid())
  title               String
  authors             String?
  publicationDate     DateTime?
  journal             String?
  doi                 String?   @unique
  abstract            String?
  sourceName          String?
  sourceUrl           String?
  topic               String?
  geographicRelevance String?
  language            String?   @default("en")
  categoryId          String?
  sourceId            String?
  locationId          String?
  isDemo              Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  location            Location? @relation(fields: [locationId], references: [id])
  source              Source?   @relation(fields: [sourceId], references: [id])

  @@index([topic])
  @@index([isDemo])
}

model DataGap {
  id                   String    @id @default(cuid())
  locationId           String?
  categorySlug         String?
  categoryName         String?
  gapLevel             String?
  description          String?
  availability         Boolean   @default(false)
  recency              String?
  geographicCoverage   String?
  temporalCoverage     String?
  parameterCoverage    String?
  sourceDiversity      String?
  measurementFrequency String?
  isDemo               Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  location             Location? @relation(fields: [locationId], references: [id])

  @@index([locationId])
  @@index([categorySlug])
  @@index([isDemo])
}

model IntelligenceSummary {
  id                       String    @id @default(cuid())
  locationId               String?
  whatWeKnow               String?
  whatChanged              String?
  whatMatters              String?
  whatWeDontKnow           String?
  evidenceStrength         String?
  sourcesSummary           String?
  language                 String    @default("en")
  generatedFromEvidenceIds String?
  isAIGenerated            Boolean   @default(false)
  isDemo                   Boolean   @default(false)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  location                 Location? @relation(fields: [locationId], references: [id])

  @@index([locationId])
  @@index([isDemo])
}

model TimelineEvent {
  id           String    @id @default(cuid())
  locationId   String?
  date         DateTime?
  year         Int?
  title        String
  description  String?
  categorySlug String?
  evidenceType String?
  sourceUrl    String?
  sourceName   String?
  isDemo       Boolean   @default(false)
  createdAt    DateTime  @default(now())
  location     Location? @relation(fields: [locationId], references: [id])

  @@index([locationId])
  @@index([categorySlug])
  @@index([isDemo])
}

model UpdateLog {
  id               String    @id @default(cuid())
  sourceId         String?
  status           String    @default("success")
  recordsAdded     Int       @default(0)
  recordsUpdated   Int       @default(0)
  recordsRejected  Int       @default(0)
  validationErrors String?
  errorMessage     String?
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  source           Source?   @relation(fields: [sourceId], references: [id])

  @@index([sourceId])
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  role           String   @default("viewer")
  savedLocations String?
  savedResearch  String?
  savedEvidence  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([role])
}

model Order {
  id               String   @id @default(cuid())
  userId           String?
  userEmail        String?
  orderType        String?
  amount           Float?
  currency         String?  @default("BDT")
  paymentStatus    String   @default("pending")
  paymentReference String?
  paymentProof     String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([paymentStatus])
}

model KnowledgeArticle {
  id                   String   @id @default(cuid())
  slug                 String   @unique
  title                String
  titleBn              String?
  content              String?
  categoryId           String?
  relatedLocationSlugs String?
  relatedTopicSlugs    String?
  language             String   @default("en")
  isPublished          Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([isPublished])
}
