// ============================================================
// ENVEVIDENCE — DATABASE SCHEMA
// PostgreSQL (Supabase-compatible)
// ============================================================
// Architecture designed for PostgreSQL / Supabase.
// Never invent environmental data. Data provenance is the foundation.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// LOCATIONS
// ============================================================

model Location {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  nameBn      String?
  country     String
  region      String?
  city        String?
  district    String?
  latitude    Float?
  longitude   Float?
  type        String   @default("city")
  parentId    String?
  parent      Location?  @relation("LocationHierarchy", fields: [parentId], references: [id])
  children    Location[] @relation("LocationHierarchy")
  description String?
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  evidenceRecords      EvidenceRecord[]
  researchItems        ResearchItem[]
  dataGaps             DataGap[]
  intelligenceSummaries IntelligenceSummary[]
  timelineEvents       TimelineEvent[]

  @@index([slug])
  @@index([country])
  @@index([type])
  @@index([isDemo])
}

// ============================================================
// ENVIRONMENTAL CATEGORIES & PARAMETERS
// ============================================================

model EnvironmentalCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  nameBn    String?
  icon      String?
  color     String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  parameters      Parameter[]
  evidenceRecords EvidenceRecord[]
}

model Parameter {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  nameBn      String?
  unit        String?
  categoryId  String
  category    EnvironmentalCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  description String?
  createdAt   DateTime @default(now())

  evidenceRecords EvidenceRecord[]

  @@index([categoryId])
}

// ============================================================
// DATA SOURCES (Source Registry)
// ============================================================

model Source {
  id                  String    @id @default(cuid())
  name                String
  provider            String?
  url                 String?
  apiEndpoint         String?
  license             String?
  commercialUse       String?   @default("REQUIRES REVIEW")
  attributionReq      String?
  updateFrequency     String?
  dataCategories      String?
  geographicCoverage  String?
  temporalCoverage    String?
  reliabilityNotes    String?
  ingestionMethod     String?
  status              String    @default("active")
  lastSuccessfulFetch DateTime?
  nextScheduledUpdate DateTime?
  lastFailureReason   String?
  errorCount          Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  evidenceRecords EvidenceRecord[]
  researchItems   ResearchItem[]
  updateLogs      UpdateLog[]

  @@index([status])
}

// ============================================================
// EVIDENCE RECORDS (Core Data with Full Provenance)
// ============================================================

model EvidenceRecord {
  id                    String   @id @default(cuid())

  // What was measured/observed
  value                 String?
  numericValue          Float?
  unit                  String?
  parameterId           String?
  parameter             Parameter? @relation(fields: [parameterId], references: [id])
  categoryId            String?
  category              EnvironmentalCategory? @relation(fields: [categoryId], references: [id])

  // Where
  locationId            String?
  location              Location? @relation(fields: [locationId], references: [id])
  samplingSite          String?
  latitude              Float?
  longitude             Float?
  geographicPrecision   String?

  // When
  observationDate       DateTime?
  sourcePublicationDate DateTime?
  collectionDate        DateTime?
  retrievalDate         DateTime  @default(now())

  // Source / Provenance
  sourceId              String?
  source                Source? @relation(fields: [sourceId], references: [id])
  sourceTitle           String?
  sourceUrl             String?
  doi                   String?
  originalDatasetUrl    String?
  publisher             String?
  originalLanguage      String?  @default("en")

  // Methodology
  methodology           String?
  measurementMethod     String?

  // Licensing
  license               String?
  commercialUseStatus   String?  @default("REQUIRES REVIEW")
  attributionRequirements String?

  // Processing
  processingHistory     String?

  // Confidence & Verification
  confidence            String   @default("UNVERIFIED")
  evidenceType          String?
  verificationStatus    String   @default("pending")

  // Claim / Description
  claim                 String?

  // Data Quality
  qualityStatus         String   @default("valid")
  qualityNotes          String?

  // Demo isolation
  isDemo                Boolean  @default(false)

  // Timestamps
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([locationId])
  @@index([categoryId])
  @@index([sourceId])
  @@index([confidence])
  @@index([verificationStatus])
  @@index([isDemo])
  @@index([evidenceType])
}

// ============================================================
// RESEARCH ITEMS
// ============================================================

model ResearchItem {
  id                String    @id @default(cuid())
  title             String
  authors           String?
  publicationDate   DateTime?
  journal           String?
  doi               String?   @unique
  abstract          String?
  sourceName        String?
  sourceUrl         String?
  topic             String?
  geographicRelevance String?
  language          String?   @default("en")
  categoryId        String?
  sourceId          String?
  source            Source?   @relation(fields: [sourceId], references: [id])
  locationId        String?
  location          Location? @relation(fields: [locationId], references: [id])
  isDemo            Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([topic])
  @@index([isDemo])
}

// ============================================================
// DATA GAPS
// ============================================================

model DataGap {
  id              String   @id @default(cuid())
  locationId      String?
  location        Location? @relation(fields: [locationId], references: [id])
  categorySlug    String?
  categoryName    String?
  gapLevel        String?
  description     String?
  availability    Boolean  @default(false)
  recency         String?
  geographicCoverage String?
  temporalCoverage   String?
  parameterCoverage  String?
  sourceDiversity    String?
  measurementFrequency String?
  isDemo          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([locationId])
  @@index([categorySlug])
  @@index([isDemo])
}

// ============================================================
// INTELLIGENCE SUMMARIES
// ============================================================

model IntelligenceSummary {
  id              String   @id @default(cuid())
  locationId      String?
  location        Location? @relation(fields: [locationId], references: [id])
  whatWeKnow      String?
  whatChanged     String?
  whatMatters     String?
  whatWeDontKnow  String?
  evidenceStrength String?
  sourcesSummary  String?
  language        String   @default("en")
  generatedFromEvidenceIds String?
  isAIGenerated   Boolean  @default(false)
  isDemo          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([locationId])
  @@index([isDemo])
}

// ============================================================
// TIMELINE EVENTS
// ============================================================

model TimelineEvent {
  id              String   @id @default(cuid())
  locationId      String?
  location        Location? @relation(fields: [locationId], references: [id])
  date            DateTime?
  year            Int?
  title           String
  description     String?
  categorySlug    String?
  evidenceType    String?
  sourceUrl       String?
  sourceName      String?
  isDemo          Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([locationId])
  @@index([categorySlug])
  @@index([isDemo])
}

// ============================================================
// UPDATE LOGS (Data Ingestion Tracking)
// ============================================================

model UpdateLog {
  id              String   @id @default(cuid())
  sourceId        String?
  source          Source?  @relation(fields: [sourceId], references: [id])
  status          String   @default("success")
  recordsAdded    Int      @default(0)
  recordsUpdated  Int      @default(0)
  recordsRejected Int      @default(0)
  validationErrors String?
  errorMessage    String?
  startedAt       DateTime @default(now())
  completedAt     DateTime?

  @@index([sourceId])
}

// ============================================================
// USERS (Extensible Auth)
// ============================================================

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String?
  role            String   @default("viewer")
  savedLocations  String?
  savedResearch   String?
  savedEvidence   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([role])
}

// ============================================================
// ORDERS / INQUIRIES
// ============================================================

model Order {
  id              String   @id @default(cuid())
  userId          String?
  userEmail       String?
  orderType       String?
  amount          Float?
  currency        String?   @default("BDT")
  paymentStatus   String   @default("pending")
  paymentReference String?
  paymentProof    String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([paymentStatus])
}

// ============================================================
// KNOWLEDGE ARTICLES
// ============================================================

model KnowledgeArticle {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  titleBn         String?
  content         String?
  categoryId      String?
  relatedLocationSlugs String?
  relatedTopicSlugs   String?
  language        String   @default("en")
  isPublished     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isPublished])
}
