<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none">
  <defs>
    <linearGradient id="faviconGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#059669;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0284c7;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Main hexagon -->
  <polygon points="32,8 48,18 48,34 32,44 16,34 16,18" fill="url(#faviconGradient)"/>
  
  <!-- Data points -->
  <circle cx="22" cy="28" r="3" fill="white"/>
  <circle cx="32" cy="22" r="2" fill="white" opacity="0.8"/>
  <circle cx="42" cy="28" r="3" fill="white"/>
  
  <!-- Verification checkmark -->
  <path d="M 24 32 L 30 38 L 40 30" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
